{
	"name": "helice-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r build",
		"test": "pnpm -r --if-present test",
		"test:watch": "pnpm --filter helice test:watch",
		"check-types": "pnpm -r --if-present check-types",
		"site": "pnpm --filter helice build && pnpm --filter @helice/site dev",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm --filter helice build && changeset publish"
	},
	"author": "Guillaume Vailland (Tyren)",
	"license": "MIT",
	"devDependencies": {
		"@changesets/cli": "^2.31.0"
	},
	"packageManager": "pnpm@10.28.2"
}
